# Copy into Streamlit Cloud: App -> Settings -> Secrets. Never commit real keys.
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-5-5"
SEC_USER_AGENT = "Your Name your-email@example.com"   # SEC asks every request to identify a contact
APP_PASSCODE = "choose-a-passcode"                    # only someone with this can trigger real AI calls
MAX_MODEL_CALLS_PER_SESSION = "120"                   # hard cap per browser session
